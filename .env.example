#-------------------------------------------------------------------------
# Electrónica del Hogar — plantilla de configuración
#-------------------------------------------------------------------------
# Copia este archivo a .env y rellena los valores. El .env NUNCA se versiona:
# lleva la APP_KEY, y sin ella no se descifran sesiones ni tokens.
#
# Los valores marcados «producción» están explicados en docs/DESPLIEGUE.md.

APP_NAME="Electrónica del Hogar"
APP_ENV=local
APP_KEY=
# Producción: false SIEMPRE. Con true, cualquier error muestra la ruta del
# servidor, el contenido del .env y trozos de consulta al primer visitante.
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# Producción: error. Con debug, el log guarda cada consulta y llena el disco.
LOG_LEVEL=debug

#-------------------------------------------------------------------------
# Base de datos
#-------------------------------------------------------------------------
# El driver es `mariadb`, no `mysql`: XAMPP trae MariaDB y el SQL que genera
# el driver correcto no es el mismo (ver docs/PLAN.md §10).
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=electronica_hogar
DB_USERNAME=root
DB_PASSWORD=

# Carpeta de mysqldump, que las copias de seguridad necesitan y que XAMPP no
# pone en el PATH. Vacío = se busca en el PATH del sistema.
# Con barras normales: entre comillas, dotenv interpreta `\x` como escape y
# el archivo entero deja de parsearse («unexpected escape sequence»).
DB_DUMP_BINARY_PATH="C:/xampp/mysql/bin"

#-------------------------------------------------------------------------
# Sesión, colas y caché
#-------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Producción con HTTPS: true, para que la cookie de sesión no viaje en claro.
SESSION_SECURE_COOKIE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Producción: redis, si está disponible. Las notificaciones y los avisos push
# no deben frenar el cobro en caja.
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#-------------------------------------------------------------------------
# Correo
#-------------------------------------------------------------------------
# `log` escribe los correos en storage/logs en vez de enviarlos: sirve para
# desarrollo, pero en producción deja al usuario sin recuperar su contraseña.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="sistema@electronicahogar.test"
MAIL_FROM_NAME="${APP_NAME}"

#-------------------------------------------------------------------------
# Copias de seguridad (spatie/laravel-backup)
#-------------------------------------------------------------------------
# A quién se avisa cuando la copia falla o cuando la última tiene más de un
# día. Si se deja vacío se usa MAIL_FROM_ADDRESS.
BACKUP_NOTIFICATION_MAIL=
# Contraseña del ZIP. Recomendable si las copias salen del servidor: llevan
# dentro el .env con la APP_KEY.
BACKUP_ARCHIVE_PASSWORD=

#-------------------------------------------------------------------------
# Reverb (WebSockets del dashboard en vivo)
#-------------------------------------------------------------------------
# Genera tus propias credenciales; no reutilices las de otra instalación.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
# Producción: https, detrás del proxy, para que el navegador abra wss://
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

#-------------------------------------------------------------------------
# Firebase (avisos push a la app Flutter) — opcional
#-------------------------------------------------------------------------
# Sin esto el sistema funciona igual: los avisos se guardan y se leen por
# GET /api/v1/notificaciones; solo no llegan al teléfono.
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=
